# Variables mínimas de Chatwoot CE para Loopchat (completar; nunca commitear el .env real).
# Referencia completa: https://github.com/chatwoot/chatwoot/blob/v4.19.0/.env.example
CHATWOOT_VERSION=v4.19.0
SECRET_KEY_BASE=            # openssl rand -hex 64
FRONTEND_URL=https://chatwoot.tu-dominio.com   # URL pública: Meta envía los webhooks a /webhooks/whatsapp/<numero>
DEFAULT_LOCALE=es
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false  # las cuentas las crea Loopchat por Platform API
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=chatwoot
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
ACTIVE_STORAGE_SERVICE=local
# Cifrado de columnas sensibles (tokens de WhatsApp, secretos de webhooks):
# bundle exec rails db:encryption:init  → copiar las tres claves
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
# Opcional: SMTP de Chatwoot (Loopchat no usa la UI de Chatwoot para agentes)
MAILER_SENDER_EMAIL=
SMTP_ADDRESS=
