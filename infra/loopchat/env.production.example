# ─────────────────────────────────────────────────────────────────────────────
# Loopchat — PRODUCCIÓN (VPS). Copiar a /opt/loopchat/.env.production, completar, chmod 600.
# Ningún valor de este archivo es real. Nunca commitear el archivo completado.
# Uso: docker compose -f infra/loopchat/docker-compose.yml --env-file .env.production …
# ─────────────────────────────────────────────────────────────────────────────

# ── Dominios (parametrizados: cambiar acá y en /etc/caddy/caddy.env) ───────────
# Ejemplo: app.loop-smith.com / chatwoot.loop-smith.com (dominio aún no confirmado)
APP_URL=https://APP_DOMAIN
CHATWOOT_BASE_URL=https://CHATWOOT_DOMAIN
# Chatwoot rechaza webhooks a IPs privadas: usar la URL pública HTTPS de Loopchat
CHATWOOT_WEBHOOK_TARGET_URL=https://APP_DOMAIN

# ── Base de datos (el compose arma DATABASE_URL con esta contraseña) ──────────
# openssl rand -base64 32 | tr -d '/+='
LOOPCHAT_DB_PASSWORD=
DB_POOL_MAX=10

# ── Secretos de la aplicación ────────────────────────────────────────────────
# MIGRACIÓN DESDE LA PC: copiar EXACTAMENTE los valores del .env local. Si cambian, las sesiones se
# invalidan (BETTER_AUTH_SECRET) y las credenciales cifradas de IA/Meta/Chatwoot no se pueden leer
# (LOOPCHAT_ENCRYPTION_KEYS). Guardarlos también en el gestor de secretos.
BETTER_AUTH_SECRET=
LOOPCHAT_ENCRYPTION_KEYS=

# ── Chatwoot ─────────────────────────────────────────────────────────────────
# Token de la Platform App (vive en la base de Chatwoot migrada: el mismo que en local)
CHATWOOT_PLATFORM_TOKEN=
META_GRAPH_BASE_URL=https://graph.facebook.com/v22.0

# ── Email transaccional: Resend por SMTP ─────────────────────────────────────
# smtps (TLS implícito, puerto 465), usuario "resend", contraseña = API key de Resend (re_…).
# El dominio del remitente debe estar verificado en Resend (registros SPF/DKIM en el DNS).
SMTP_URL=smtps://resend:RESEND_API_KEY@smtp.resend.com:465
MAIL_FROM=Loopchat <no-reply@MAIL_DOMAIN>

# ── Modo producción (la app no arranca con valores inseguros) ────────────────
LOOPCHAT_INLINE_WORKER=false
LOOPCHAT_ALLOW_PRIVATE_URLS=false
LOOPCHAT_DEMO_MODE=false
# Caddy en el host → la app ve el gateway de Docker. Caddy entrega la IP real (ver infra/caddy/Caddyfile).
TRUSTED_PROXIES=172.16.0.0/12
STORAGE_DIR=/data/storage
AI_REQUEST_TIMEOUT_MS=20000
LOG_LEVEL=info
# Opcional: /api/health detallado con header x-health-token. openssl rand -hex 24
HEALTH_TOKEN=

# ── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=8
WORKER_TENANT_CONCURRENCY=2
WORKER_LEASE_SECONDS=120

# ── Monitor y alertas ────────────────────────────────────────────────────────
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
ALERT_REPEAT_HOURS=6
BACKUP_MAX_AGE_HOURS=26
RESTORE_TEST_MAX_AGE_HOURS=192
