{
  "name": "loopchat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed:plans": "tsx --conditions=react-server scripts/seed-plans.ts",
    "db:seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "bootstrap:admin": "tsx --conditions=react-server scripts/bootstrap-admin.ts",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "sim:chatwoot": "tsx tools/chatwoot-sim/server.ts",
    "sim:ai": "tsx tools/ai-sim/server.ts",
    "db:seed:demo-sim": "tsx --conditions=react-server scripts/seed-demo-sim.ts",
    "verify:restore": "tsx --conditions=react-server scripts/verify-restore.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo:message": "tsx scripts/demo-message.ts",
    "sim:chatwoot:demo": "tsx tools/chatwoot-sim/server.ts --state storage/chatwoot-sim-state.json",
    "demo:check": "tsx scripts/demo-check.ts",
    "demo:chat": "tsx scripts/demo-chat.ts",
    "db:seed:demo-catalog": "tsx --conditions=react-server scripts/seed-demo-catalog.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
