# ─────────────────────────────────────────────────────────────
# Loopchat — variables de entorno (copiar a .env y completar)
# Nunca commitear .env. Ningún valor de este archivo es real.
# ─────────────────────────────────────────────────────────────

# URL pública de Loopchat (en producción con https://)
APP_URL=http://localhost:3000

# PostgreSQL PROPIO de Loopchat (separado de la DB de Chatwoot)
DATABASE_URL=postgres://loopchat:loopchat@localhost:5432/loopchat_dev
# Solo para tests de integración (se borra y recrea en cada corrida)
TEST_DATABASE_URL=postgres://loopchat:loopchat@localhost:5432/loopchat_test
DB_POOL_MAX=10

# Sesiones (Better Auth). Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=

# Cifrado de credenciales en reposo (AES-256-GCM). Formato: id:base64(32 bytes)[,idAnterior:base64]
# La primera clave cifra; las siguientes solo descifran (rotación). Generar 32 bytes:
#   node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
LOOPCHAT_ENCRYPTION_KEYS=

# Chatwoot Community Edition (servicio separado; ver infra/chatwoot)
CHATWOOT_BASE_URL=http://localhost:3001
# Token de la Platform App creada en Chatwoot Super Admin (/super_admin/platform_apps)
CHATWOOT_PLATFORM_TOKEN=
# URL a la que Chatwoot envía webhooks de Loopchat (si difiere de APP_URL, p.ej. red Docker)
CHATWOOT_WEBHOOK_TARGET_URL=

# Graph API de Meta (solo lectura para verificar números; los envíos van por Chatwoot)
META_GRAPH_BASE_URL=https://graph.facebook.com/v22.0

# Email transaccional (invitaciones, restablecer contraseña). Ej: smtp://usuario:clave@smtp.proveedor.com:587
# Sin SMTP_URL, en desarrollo los emails quedan en la tabla dev_mail_outbox (en producción falla).
SMTP_URL=
MAIL_FROM=Loopchat <no-reply@tu-dominio.com>

# Archivos de conocimiento subidos (TXT/MD/PDF). En producción, un volumen persistente con backup.
STORAGE_DIR=./storage

# true: el proceso web también procesa la cola (desarrollo). En producción usar `npm run worker`.
LOOPCHAT_INLINE_WORKER=true

# SOLO desarrollo/test: permite URLs privadas (simuladores locales). Prohibido en producción.
LOOPCHAT_ALLOW_PRIVATE_URLS=false

# Muestra la vista de diseño /demo (datos ficticios rotulados DEMO)
LOOPCHAT_DEMO_MODE=false

AI_REQUEST_TIMEOUT_MS=20000
LOG_LEVEL=info

# Bootstrap del primer administrador de Loop Smiths (npm run bootstrap:admin)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
